# Redmi AX6 纯净版编译配置（LibWrt 25.12-nss）
# 机型：redmi_ax6（IPQ8071A / IPQ807X）
# 所有包名均已对照源码核实：
#   主树 target/linux/qualcommax/image/ipq807x.mk
#   feeds nss_packages (laipeng668/nss-packages, 分支 NSS-LibWrt)
# 原则：只留系统 + WiFi + NSS 全套加速所需，不含任何第三方代理插件。

# ---------- 目标平台与机型 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6=y

# ---------- NSS 核心三件套（缺一不可）----------
# SSDK：交换芯片抽象层
CONFIG_PACKAGE_kmod-qca-ssdk=y
# NSS-DP：数据面驱动，流量走 NSS 的入口（依赖 ssdk）
CONFIG_PACKAGE_kmod-qca-nss-dp=y
# NSS-DRV：NSS 核心驱动（依赖 nss-dp + nss-firmware）
CONFIG_PACKAGE_kmod-qca-nss-drv=y
# ECM：增强连接管理器，负责把连接卸载到 NSS，不装基本等于没加速
CONFIG_PACKAGE_kmod-qca-nss-ecm=y

# ---------- NSS 固件（AX6 属 ipq807x，不是 8074）----------
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y
# 固件版本：默认 11.4，家用（WiFi/PPPoE/桥接/VLAN）足够
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# ---------- NSS 内存 profile：AX6 只有 512MB ----------
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

# ---------- NSS 功能开关（对应 Config.in 的 CONFIG_NSS_DRV_*）----------
CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_MATCH_ENABLE=y
CONFIG_NSS_DRV_GRE_ENABLE=y
CONFIG_NSS_DRV_PVXLAN_ENABLE=y
CONFIG_NSS_DRV_TUN6RD_ENABLE=y
CONFIG_NSS_DRV_TUNIPIP6_ENABLE=y
# ECM 的硬依赖，必须开
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y

# ---------- NSS 客户端子模块（对应 feeds 里真实包名）----------
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pvxlanmgr=y

# ---------- WiFi：ath11k（AX6 的 QCN5024/QCN5054 走 PCI）----------
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y

# ---------- PPPoE 拨号（国内宽带基本都要）----------
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ---------- LuCI 基础界面 + 中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# ---------- 常用排障小工具 ----------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_ethtool=y

# ---------- 明确关闭：代理类插件一律不装（纯净版关键）----------
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-sing-box is not set
# CONFIG_PACKAGE_luci-app-v2raya is not set
# CONFIG_PACKAGE_luci-app-ddns-go is not set
# CONFIG_PACKAGE_chinadns-ng is not set
# CONFIG_PACKAGE_dns2socks is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
